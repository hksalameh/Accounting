<UserControl x:Class="AccountingApp.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AccountingApp"
             FlowDirection="RightToLeft"
             Background="#F7FAFC"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <local:ZeroToEmptyStringConverter x:Key="ZeroToEmptyStringConverter" />
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Background" Value="#3182CE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- الصف الأول: الأرصدة والسنة المالية -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="السنة المالية:" VerticalAlignment="Center" FontWeight="Bold" FontSize="18" Margin="0 0 5 0"/>
            <ComboBox x:Name="YearComboBox" Width="87" Height="28" FontSize="16" SelectionChanged="YearComboBox_SelectionChanged" Margin="0,0,30,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Text="رصيد الفواتير:" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" Margin="0,0,5,0"/>
            <TextBlock x:Name="InvoicesBalanceText" Text="0.000" FontSize="20" FontWeight="Bold" Foreground="White" Background="#2F855A" Padding="15,7" TextAlignment="Center" Margin="0,0,20,0"/>
            <TextBlock Text="الرصيد الافتتاحي:" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" Margin="0,0,5,0"/>
            <TextBox x:Name="OpeningBalanceTextBox" Width="90" FontSize="16" Text="0" KeyDown="OpeningBalanceTextBox_KeyDown" TextAlignment="Center"/>
            <Button Content="تحديث" Width="80" Height="30" FontSize="14" Click="UpdateOpeningBalance_Click"/>
        </StackPanel>

        <!-- الصف الثاني: البحث -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 20">
            <TextBlock Text="بحث بالبيان:" VerticalAlignment="Center" FontWeight="Bold" Margin="0 0 5 0"/>
            <TextBox x:Name="SearchTextBox" Width="200" TextAlignment="Center" KeyDown="MoveFocusOnEnter"/>
            <TextBlock Text="من تاريخ:" VerticalAlignment="Center" FontWeight="Bold" Margin="0 0 5 0"/>
            <TextBox x:Name="FromDateTextBox" Width="100" TextAlignment="Center" KeyDown="DateInput_KeyDown"/>
            <TextBlock Text="إلى تاريخ:" VerticalAlignment="Center" FontWeight="Bold" Margin="0 0 5 0"/>
            <TextBox x:Name="ToDateTextBox" Width="100" TextAlignment="Center" KeyDown="DateInput_KeyDown"/>
            <Button Content="بحث" Width="81" Height="30" Click="Search_Click" FontSize="14"/>
            <Button Content="إظهار الكل" Width="90" Height="30" Click="ShowAll_Click" FontSize="14"/>
            <Button Content="طباعة" Width="80" Height="30" Click="Print_Click" FontSize="14" Background="#2F855A" Margin="20,5,5,5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 20">

            <TextBlock Text="التاريخ:" VerticalAlignment="Center" FontWeight="Bold" Margin="0 0 5 0"/>
            <TextBox x:Name="InvoiceDateTextBox" Width="91" KeyDown="InvoiceDate_KeyDown" TextAlignment="Center"/>

            <TextBlock Text="رقم الفاتورة:" VerticalAlignment="Center" FontWeight="Bold" Margin="0 0 5 0"/>
            <TextBox x:Name="InvoiceNoTextBox" Width="86" KeyDown="MoveFocusOnEnter" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>

            <TextBlock Text="البيان:" VerticalAlignment="Center" FontWeight="Bold" Margin="0 0 5 0"/>
            <TextBox x:Name="DescriptionTextBox" Width="237" KeyDown="MoveFocusOnEnter" TextAlignment="Center"/>
            <TextBlock Text="مدين:" VerticalAlignment="Center" FontWeight="Bold" Margin="0 0 5 0"/>
            <TextBox x:Name="DebitTextBox" Width="68" KeyDown="MoveFocusOnEnter" TextAlignment="Center"/>
            <TextBlock Text="دائن:" VerticalAlignment="Center" FontWeight="Bold" Margin="0 0 5 0"/>
            <TextBox x:Name="CreditTextBox" Width="68" KeyDown="CreditTextBox_KeyDown" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            <Button x:Name="AddUpdateButton" Content="إضافة الفاتورة" Width="104" Height="30" Click="AddUpdateInvoice_Click" FontSize="14"/>
            <Button x:Name="CancelEditButton" Content="إلغاء التعديل" Width="120" Height="30" Click="CancelEdit_Click" Visibility="Collapsed" Background="#A0AEC0"/>
        </StackPanel>

        <DataGrid x:Name="InvoicesDataGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                  FontSize="14" AlternatingRowBackground="#EDF2F7" RowBackground="White"
                  SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="م" Binding="{Binding Id}" Width="60" ElementStyle="{StaticResource CenteredCellStyle}"/>

                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={x:Static local:AppSettings.DateFormat}}" Width="1.5*" ElementStyle="{StaticResource CenteredCellStyle}"/>

                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNo}" Width="*" ElementStyle="{StaticResource CenteredCellStyle}"/>

                <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="3*" ElementStyle="{StaticResource CenteredCellStyle}"/>
                <DataGridTextColumn Header="مدين" Binding="{Binding Debit, Converter={StaticResource ZeroToEmptyStringConverter}}" Width="*" ElementStyle="{StaticResource CenteredCellStyle}"/>
                <DataGridTextColumn Header="دائن" Binding="{Binding Credit, Converter={StaticResource ZeroToEmptyStringConverter}}" Width="*" ElementStyle="{StaticResource CenteredCellStyle}"/>
                <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N3}" Width="1.5*" ElementStyle="{StaticResource CenteredCellStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
            <Button Content="تعديل الفاتورة" Width="94" Height="35" Background="#DD6B20" Click="EditInvoice_Click" FontSize="14"/>
            <Button Content="حذف الفاتورة" Width="91" Height="35" Background="#E53E3E" Click="DeleteInvoice_Click" FontSize="14"/>
        </StackPanel>
    </Grid>
</UserControl>
