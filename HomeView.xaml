<UserControl x:Class="AccountingApp.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#EDF2F7"
             Loaded="HomeView_Loaded">
    <UserControl.Resources>
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" Color="#000000" Opacity="0.05" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock" x:Key="TitleStyle">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="AmountStyle">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SmallCardTitleStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SmallCardAmountStyle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBlock Text="الملخص المالي للسنة:" FontSize="28" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                <ComboBox x:Name="YearComboBox" Width="100" Height="32" FontSize="16" VerticalAlignment="Center" Margin="20,0,0,0" SelectionChanged="YearComboBox_SelectionChanged"/>
            </StackPanel>

            <TextBlock x:Name="BalanceErrorText"
                       Text="تعذر قراءة الأرصدة من قاعدة البيانات."
                       Visibility="Collapsed"
                       Foreground="#C53030"
                       Background="#FFF5F5"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Padding="12,8"
                       Margin="10,0,10,15"
                       TextAlignment="Center"
                       HorizontalAlignment="Stretch"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Style="{StaticResource CardStyle}" MinWidth="250">
                    <StackPanel>
                        <TextBlock x:Name="RevenuesBalanceCardTitle" Text="رصيد الإيرادات" Style="{StaticResource TitleStyle}" HorizontalAlignment="Center"/>
                        <Separator Margin="0,10"/>
                        <TextBlock x:Name="TotalRevenuesText" Text="0.000" Style="{StaticResource AmountStyle}" Foreground="#2F855A"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" MinWidth="250">
                    <StackPanel>
                        <TextBlock x:Name="InvoicesBalanceCardTitle" Text="رصيد صندوق الفواتير" Style="{StaticResource TitleStyle}" HorizontalAlignment="Center"/>
                        <Separator Margin="0,10"/>
                        <TextBlock x:Name="TotalExpensesText" Text="0.000" Style="{StaticResource AmountStyle}" Foreground="#4A5568"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" MinWidth="300" Background="#3182CE">
                    <StackPanel>
                        <TextBlock Text="رصيد الصندوق" Style="{StaticResource TitleStyle}" HorizontalAlignment="Center" Foreground="White"/>
                        <Separator Margin="0,10" Background="#A3BFDB"/>
                        <TextBlock x:Name="FundBalanceText" Text="0.000" Style="{StaticResource AmountStyle}" Foreground="White"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="تفاصيل حركة السنة المالية" FontSize="18" FontWeight="Bold" Foreground="#4A5568" Margin="0,20,0,8" HorizontalAlignment="Center"/>

            <WrapPanel HorizontalAlignment="Center" MaxWidth="1150">
                <Border Style="{StaticResource CardStyle}" Width="210" MinHeight="105">
                    <StackPanel>
                        <TextBlock Text="إجمالي سندات القبض" Style="{StaticResource SmallCardTitleStyle}"/>
                        <TextBlock x:Name="TotalReceiptsSummaryText" Text="0.000" Style="{StaticResource SmallCardAmountStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="210" MinHeight="105">
                    <StackPanel>
                        <TextBlock Text="إجمالي الإيداعات" Style="{StaticResource SmallCardTitleStyle}"/>
                        <TextBlock x:Name="TotalDepositsSummaryText" Text="0.000" Style="{StaticResource SmallCardAmountStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="210" MinHeight="105">
                    <StackPanel>
                        <TextBlock Text="تغذية صندوق الفواتير" Style="{StaticResource SmallCardTitleStyle}"/>
                        <TextBlock x:Name="FundAdditionsSummaryText" Text="0.000" Style="{StaticResource SmallCardAmountStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="210" MinHeight="105">
                    <StackPanel>
                        <TextBlock Text="صرف الفواتير" Style="{StaticResource SmallCardTitleStyle}"/>
                        <TextBlock x:Name="InvoiceExpensesSummaryText" Text="0.000" Style="{StaticResource SmallCardAmountStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="210" MinHeight="105">
                    <StackPanel>
                        <TextBlock Text="إجمالي مبالغ المساعدات" Style="{StaticResource SmallCardTitleStyle}"/>
                        <TextBlock x:Name="AidsSummaryText" Text="0.000" Style="{StaticResource SmallCardAmountStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="210" MinHeight="105">
                    <StackPanel>
                        <TextBlock Text="إجمالي فواتير الوقود" Style="{StaticResource SmallCardTitleStyle}"/>
                        <TextBlock x:Name="FuelSummaryText" Text="0.000" Style="{StaticResource SmallCardAmountStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="210" MinHeight="105">
                    <StackPanel>
                        <TextBlock Text="الوقود غير المدفوع" Style="{StaticResource SmallCardTitleStyle}"/>
                        <TextBlock x:Name="UnpaidFuelSummaryText" Text="0.000" Style="{StaticResource SmallCardAmountStyle}" Foreground="#C53030" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
