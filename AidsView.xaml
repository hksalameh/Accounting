<UserControl x:Class="AccountingApp.AidsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AccountingApp"
             FlowDirection="RightToLeft"
             Background="#F1F5F9"
             Loaded="AidsView_Loaded">
    <UserControl.Resources>
        <local:ZeroToEmptyStringConverter x:Key="ZeroToEmptyConverter"/>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" Opacity="0.06" BlurRadius="14"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,11"/>
        </Style>

        <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Margin" Value="0,0,0,11"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F7"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18,13">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right">
                    <TextBlock Text="المساعدات" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="إدخال وبحث ومراجعة المساعدات من شاشة واحدة" Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="السنة المالية" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="YearComboBox"
                              Width="105"
                              Style="{StaticResource FieldComboBoxStyle}"
                              Margin="0"
                              SelectionChanged="YearComboBox_SelectionChanged"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="580"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" FlowDirection="RightToLeft">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Right">
                                <TextBlock Text="بحث وعرض السجلات" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="حدد النوع والفترة أو اكتب أي كلمة للبحث" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="طباعة النتائج"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    DockPanel.Dock="Left"
                                    Width="125"
                                    Height="36"
                                    Margin="4,0,0,0"
                                    Click="Print_Click"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="115"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="بحث سريع" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="QuickSearchTextBox"
                                         Style="{StaticResource FieldTextBoxStyle}"
                                         Margin="0"
                                         ToolTip="رقم السند، المتبرع، البيان أو اسم المشروع"
                                         TextChanged="QuickSearchTextBox_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="نوع المساعدة" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="SearchProjectComboBox"
                                          Style="{StaticResource FieldComboBoxStyle}"
                                          Margin="0"
                                          SelectionChanged="SearchProjectComboBox_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="من تاريخ" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="SearchFromDateTextBox"
                                         Style="{StaticResource FieldTextBoxStyle}"
                                         Margin="0"
                                         TextAlignment="Center"
                                         KeyDown="SearchDate_KeyDown"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="إلى تاريخ" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="SearchToDateTextBox"
                                         Style="{StaticResource FieldTextBoxStyle}"
                                         Margin="0"
                                         TextAlignment="Center"
                                         KeyDown="SearchDate_KeyDown"/>
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="بحث" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,5,0" Click="Search_Click"/>
                                <Button Content="مسح البحث" Style="{StaticResource WarningButtonStyle}" Margin="0" Click="ClearSearch_Click"/>
                            </StackPanel>
                            <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="7" Padding="10,7" DockPanel.Dock="Left">
                                <TextBlock x:Name="SearchSummaryTextBlock"
                                           Text="عدد النتائج: 0"
                                           Foreground="#1E40AF"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10">
                    <TabControl x:Name="ResultsTabControl" Background="Transparent" BorderThickness="0">
                        <TabItem Header="نتائج البحث">
                            <Grid Margin="4,10,4,4">
                                <DataGrid x:Name="AidsDataGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MouseDoubleClick="AidDataGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="المشروع" Binding="{Binding ProjectName}" Width="1.25*"/>
                                        <DataGridTextColumn Header="السند" Binding="{Binding VoucherNo}" Width="85"/>
                                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={x:Static local:AppSettings.DateFormat}}" Width="92"/>
                                        <DataGridTextColumn Header="المتبرع" Binding="{Binding DonorName}" Width="1.15*"/>
                                        <DataGridTextColumn x:Name="QuantityColumn" Header="الكمية/العدد" Binding="{Binding Quantity, Converter={StaticResource ZeroToEmptyConverter}}" Width="100"/>
                                        <DataGridTextColumn x:Name="DonationTypeColumn" Header="البيان/النوع" Binding="{Binding DonationType}" Width="1.15*"/>
                                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, Converter={StaticResource ZeroToEmptyConverter}, StringFormat=N3}" Width="95"/>
                                        <DataGridTemplateColumn Header="إجراء" Width="126">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="تعديل" Style="{StaticResource WarningButtonStyle}" Padding="8,1" MinHeight="27" Margin="2" Click="EditAid_Click"/>
                                                        <Button Content="حذف" Style="{StaticResource DangerButtonStyle}" Padding="8,1" MinHeight="27" Margin="2" Click="DeleteAid_Click"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="آخر الإدخالات">
                            <Grid Margin="4,10,4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <TextBlock x:Name="RecentTitleTextBlock" Text="آخر الإدخالات" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Right"/>
                                    <TextBlock Text="انقر مرتين على السجل لتعديله" Foreground="{StaticResource MutedTextBrush}" DockPanel.Dock="Left"/>
                                </DockPanel>
                                <DataGrid x:Name="RecentEntriesDataGrid"
                                          Grid.Row="2"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MouseDoubleClick="AidDataGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="السند" Binding="{Binding VoucherNo}" Width="90"/>
                                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={x:Static local:AppSettings.DateFormat}}" Width="95"/>
                                        <DataGridTextColumn Header="المتبرع" Binding="{Binding DonorName}" Width="1.3*"/>
                                        <DataGridTextColumn x:Name="RecentQuantityColumn" Header="الكمية/العدد" Binding="{Binding Quantity, Converter={StaticResource ZeroToEmptyConverter}}" Width="105"/>
                                        <DataGridTextColumn x:Name="RecentDonationTypeColumn" Header="البيان" Binding="{Binding DonationType}" Width="1.2*"/>
                                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, Converter={StaticResource ZeroToEmptyConverter}, StringFormat=N3}" Width="95"/>
                                        <DataGridTemplateColumn Header="إجراء" Width="126">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="تعديل" Style="{StaticResource WarningButtonStyle}" Padding="8,1" MinHeight="27" Margin="2" Click="EditAid_Click"/>
                                                        <Button Content="حذف" Style="{StaticResource DangerButtonStyle}" Padding="8,1" MinHeight="27" Margin="2" Click="DeleteAid_Click"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" FlowDirection="RightToLeft" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="EntryModeTextBlock"
                                   Text="إضافة مساعدة جديدة"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock x:Name="EntryProjectHintTextBlock"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,2,4,4">
                            <TextBlock Text="نوع المساعدة" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="EntryProjectComboBox"
                                      Style="{StaticResource FieldComboBoxStyle}"
                                      SelectionChanged="EntryProjectComboBox_SelectionChanged"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="رقم السند" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="VoucherNoTextBox" Style="{StaticResource FieldTextBoxStyle}" KeyDown="MoveFocusOnEnter"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="التاريخ" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="AidDateTextBox" Style="{StaticResource FieldTextBoxStyle}" TextAlignment="Center" KeyDown="EntryDate_KeyDown"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="اسم المتبرع" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="DonorNameTextBox" Style="{StaticResource FieldTextBoxStyle}" KeyDown="MoveFocusOnEnter"/>

                            <StackPanel x:Name="DonationTypePanel">
                                <TextBlock x:Name="DonationTypeLabelTextBlock" Text="البيان" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="DonationTypeTextBox" Style="{StaticResource FieldTextBoxStyle}" KeyDown="MoveFocusOnEnter"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="QuantityLabelTextBlock" Text="الكمية/العدد" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="QuantityTextBox" Style="{StaticResource FieldTextBoxStyle}" KeyDown="MoveFocusOnEnter"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="المبلغ" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="AmountTextBox" Style="{StaticResource FieldTextBoxStyle}" KeyDown="AmountTextBox_KeyDown"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,3,0,10">
                                <TextBlock Text="Enter ينقلك بين الحقول، ومن حقل المبلغ يتم الحفظ مباشرة."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </Border>

                            <Button x:Name="SaveAidButton"
                                    Content="حفظ المساعدة"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Height="43"
                                    Margin="0,2,0,6"
                                    Click="SaveAid_Click"/>
                            <Button x:Name="CancelEditButton"
                                    Content="إلغاء التعديل"
                                    Style="{StaticResource WarningButtonStyle}"
                                    Height="39"
                                    Margin="0"
                                    Click="CancelEdit_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="3"
                            Background="#ECFDF5"
                            BorderBrush="#A7F3D0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,10,0,0">
                        <TextBlock x:Name="EntryStatusTextBlock"
                                   Text="جاهز لإضافة سجل جديد."
                                   Foreground="#047857"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
