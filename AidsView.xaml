<UserControl x:Class="AccountingApp.AidsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AccountingApp"
             FlowDirection="RightToLeft"
             Background="#EDF2F7"
             Loaded="AidsView_Loaded">
    <UserControl.Resources>
        <local:ZeroToEmptyStringConverter x:Key="ZeroToEmptyConverter"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3182CE"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C53030"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#DD6B20"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2F855A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E0"/>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" Opacity="0.06" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,12,4"/>
        </Style>

        <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,4,12,4"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="18,4"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <!-- العنوان والسنة -->
            <DockPanel Margin="0,0,0,14">
                <TextBlock Text="المساعدات" FontSize="26" FontWeight="Bold" Foreground="#2D3748" DockPanel.Dock="Right"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Left">
                    <TextBlock Text="السنة المالية:" Style="{StaticResource LabelStyle}" FontSize="15"/>
                    <ComboBox x:Name="YearComboBox" Width="110" Style="{StaticResource FieldComboBoxStyle}" SelectionChanged="YearComboBox_SelectionChanged"/>
                </StackPanel>
            </DockPanel>

            <!-- بحث سريع -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="بحث سريع" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Right"/>
                        <TextBlock Text="ابحث برقم السند أو المتبرع أو البيان" Foreground="#718096" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="بحث:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="QuickSearchTextBox"
                                     Style="{StaticResource FieldTextBoxStyle}"
                                     ToolTip="رقم السند، اسم المتبرع، البيان أو اسم المشروع"
                                     TextChanged="QuickSearchTextBox_TextChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="نوع المساعدة:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="SearchProjectComboBox"
                                      Style="{StaticResource FieldComboBoxStyle}"
                                      SelectionChanged="SearchProjectComboBox_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="من تاريخ:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="SearchFromDateTextBox" Width="120" Style="{StaticResource FieldTextBoxStyle}" TextAlignment="Center" KeyDown="SearchDate_KeyDown"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="إلى تاريخ:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="SearchToDateTextBox" Width="120" Style="{StaticResource FieldTextBoxStyle}" TextAlignment="Center" KeyDown="SearchDate_KeyDown"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,4">
                            <Button Content="بحث" Style="{StaticResource PrimaryButtonStyle}" Click="Search_Click"/>
                            <Button Content="مسح البحث" Style="{StaticResource WarningButtonStyle}" Click="ClearSearch_Click"/>
                            <Button Content="طباعة النتائج" Style="{StaticResource SuccessButtonStyle}" Click="Print_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="SearchSummaryTextBlock"
                               Text="عدد النتائج: 0"
                               Margin="0,8,0,0"
                               Foreground="#4A5568"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- نموذج الإدخال الموحد -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right">
                            <TextBlock x:Name="EntryModeTextBlock" Text="إضافة مساعدة جديدة" FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock x:Name="EntryProjectHintTextBlock" Foreground="#718096" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Text="استخدم Enter للتنقل بين الحقول، ومن المبلغ للحفظ مباشرة"
                                   Foreground="#718096" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="نوع المساعدة:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="EntryProjectComboBox"
                                      Style="{StaticResource FieldComboBoxStyle}"
                                      SelectionChanged="EntryProjectComboBox_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="رقم السند:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="VoucherNoTextBox" Style="{StaticResource FieldTextBoxStyle}" KeyDown="MoveFocusOnEnter"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="التاريخ:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="AidDateTextBox" Style="{StaticResource FieldTextBoxStyle}" TextAlignment="Center" KeyDown="EntryDate_KeyDown"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="3">
                            <TextBlock Text="اسم المتبرع:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="DonorNameTextBox" Style="{StaticResource FieldTextBoxStyle}" KeyDown="MoveFocusOnEnter"/>
                        </StackPanel>

                        <StackPanel x:Name="DonationTypePanel" Grid.Row="1" Grid.Column="0">
                            <TextBlock x:Name="DonationTypeLabelTextBlock" Text="البيان:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="DonationTypeTextBox" Style="{StaticResource FieldTextBoxStyle}" KeyDown="MoveFocusOnEnter"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock x:Name="QuantityLabelTextBlock" Text="الكمية/العدد:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="QuantityTextBox" Style="{StaticResource FieldTextBoxStyle}" KeyDown="MoveFocusOnEnter"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="المبلغ:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="AmountTextBox" Style="{StaticResource FieldTextBoxStyle}" KeyDown="AmountTextBox_KeyDown"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="5,0,0,4">
                            <Button x:Name="SaveAidButton" Content="حفظ المساعدة" Style="{StaticResource SuccessButtonStyle}" Click="SaveAid_Click"/>
                            <Button x:Name="CancelEditButton" Content="إلغاء التعديل" Style="{StaticResource WarningButtonStyle}" Click="CancelEdit_Click" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#F0FFF4" BorderBrush="#9AE6B4" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <TextBlock x:Name="EntryStatusTextBlock" Text="جاهز لإضافة سجل جديد." Foreground="#276749" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- آخر الإدخالات -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock x:Name="RecentTitleTextBlock" Text="آخر الإدخالات" FontSize="18" FontWeight="Bold" Foreground="#2D3748" DockPanel.Dock="Right"/>
                        <TextBlock Text="يمكن النقر مرتين على أي سجل لتعديله" Foreground="#718096" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    </DockPanel>

                    <DataGrid x:Name="RecentEntriesDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MinHeight="150"
                              MaxHeight="250"
                              MouseDoubleClick="AidDataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNo}" Width="110"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={x:Static local:AppSettings.DateFormat}}" Width="100"/>
                            <DataGridTextColumn Header="المتبرع" Binding="{Binding DonorName}" Width="*"/>
                            <DataGridTextColumn x:Name="RecentQuantityColumn" Header="الكمية/العدد" Binding="{Binding Quantity, Converter={StaticResource ZeroToEmptyConverter}}" Width="110"/>
                            <DataGridTextColumn x:Name="RecentDonationTypeColumn" Header="البيان" Binding="{Binding DonationType}" Width="*"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, Converter={StaticResource ZeroToEmptyConverter}, StringFormat=N3}" Width="110"/>
                            <DataGridTemplateColumn Header="إجراء" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="تعديل" Style="{StaticResource WarningButtonStyle}" Padding="10,2" MinHeight="28" Click="EditAid_Click"/>
                                            <Button Content="حذف" Style="{StaticResource DangerButtonStyle}" Padding="10,2" MinHeight="28" Click="DeleteAid_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- نتائج البحث الكاملة -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="نتائج البحث الكاملة" FontSize="18" FontWeight="Bold" Foreground="#2D3748" DockPanel.Dock="Right"/>
                        <TextBlock Text="البحث السريع يتحدث تلقائيًا أثناء الكتابة" Foreground="#718096" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    </DockPanel>

                    <DataGrid x:Name="AidsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MinHeight="230"
                              MaxHeight="480"
                              MouseDoubleClick="AidDataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المشروع" Binding="{Binding ProjectName}" Width="1.4*"/>
                            <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNo}" Width="105"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={x:Static local:AppSettings.DateFormat}}" Width="95"/>
                            <DataGridTextColumn Header="المتبرع" Binding="{Binding DonorName}" Width="1.2*"/>
                            <DataGridTextColumn x:Name="QuantityColumn" Header="الكمية/العدد" Binding="{Binding Quantity, Converter={StaticResource ZeroToEmptyConverter}}" Width="110"/>
                            <DataGridTextColumn x:Name="DonationTypeColumn" Header="البيان/النوع" Binding="{Binding DonationType}" Width="1.2*"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, Converter={StaticResource ZeroToEmptyConverter}, StringFormat=N3}" Width="105"/>
                            <DataGridTemplateColumn Header="إجراء" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="تعديل" Style="{StaticResource WarningButtonStyle}" Padding="10,2" MinHeight="28" Click="EditAid_Click"/>
                                            <Button Content="حذف" Style="{StaticResource DangerButtonStyle}" Padding="10,2" MinHeight="28" Click="DeleteAid_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
