                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="VowsAmount" Margin="0,5,20,5" KeyDown="LastField_KeyDown"/>
                            <Button x:Name="AddVowsButton" Grid.Row="3" Grid.ColumnSpan="4" Content="إضافة إدخال" HorizontalAlignment="Center" Margin="0,15,0,0" Click="AddAid_Click"/>
                        </Grid>
                    </TabItem>

                    <!-- 11. أصول ثابتة -->
                    <TabItem Header="أصول ثابتة">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="التاريخ:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="FixedAssetsDateTextBox" Margin="0,5,20,5" KeyDown="DateInput_KeyDown" TextAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="المتبرع:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="FixedAssetsDonor" Margin="0,5,0,5" KeyDown="MoveFocusOnEnter"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="البيان:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="FixedAssetsType" Margin="0,5,20,5" KeyDown="MoveFocusOnEnter"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="العدد:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="FixedAssetsQuantity" Margin="0,5,0,5" KeyDown="MoveFocusOnEnter"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="المبلغ:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="FixedAssetsAmount" Margin="0,5,20,5" KeyDown="LastField_KeyDown"/>
                            <Button x:Name="AddFixedAssetsButton" Grid.Row="3" Grid.ColumnSpan="4" Content="إضافة إدخال" HorizontalAlignment="Center" Margin="0,15,0,0" Click="AddAid_Click"/>
                        </Grid>
                    </TabItem>

                    <!-- 12. مواد مستهلكة للمركز -->
                    <TabItem Header="مواد مستهلكة للمركز">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="التاريخ:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ConsumablesCenterDateTextBox" Margin="0,5,20,5" KeyDown="DateInput_KeyDown" TextAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="المتبرع:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="ConsumablesCenterDonor" Margin="0,5,0,5" KeyDown="MoveFocusOnEnter"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="البيان:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ConsumablesCenterType" Margin="0,5,20,5" KeyDown="MoveFocusOnEnter"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="الكمية:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="ConsumablesCenterQuantity" Margin="0,5,0,5" KeyDown="MoveFocusOnEnter"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="المبلغ:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ConsumablesCenterAmount" Margin="0,5,20,5" KeyDown="LastField_KeyDown"/>
                            <Button x:Name="AddConsumablesCenterButton" Grid.Row="3" Grid.ColumnSpan="4" Content="إضافة إدخال" HorizontalAlignment="Center" Margin="0,15,0,0" Click="AddAid_Click"/>
                        </Grid>
                    </TabItem>

                    <!-- 13. أدوية ومستلزمات طبية -->
                    <TabItem Header="أدوية ومستلزمات طبية">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="التاريخ:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="MedicalDateTextBox" Margin="0,5,20,5" KeyDown="DateInput_KeyDown" TextAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="المتبرع:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="MedicalDonor" Margin="0,5,0,5" KeyDown="MoveFocusOnEnter"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="البيان:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="MedicalType" Margin="0,5,20,5" KeyDown="MoveFocusOnEnter"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="الكمية:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="MedicalQuantity" Margin="0,5,0,5" KeyDown="MoveFocusOnEnter"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="المبلغ:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="MedicalAmount" Margin="0,5,20,5" KeyDown="LastField_KeyDown"/>
                            <Button x:Name="AddMedicalButton" Grid.Row="3" Grid.ColumnSpan="4" Content="إضافة إدخال" HorizontalAlignment="Center" Margin="0,15,0,0" Click="AddAid_Click"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </GroupBox>

            <GroupBox Header="قائمة المساعدات" Margin="0,15,0,0">
                <DataGrid x:Name="AidsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="200" MaxHeight="400" SelectionChanged="AidsDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المشروع" Binding="{Binding ProjectName}" Width="*"/>

                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={x:Static local:AppSettings.DateFormat}}" Width="Auto"/>
                        <DataGridTextColumn Header="المتبرع" Binding="{Binding DonorName}" Width="*"/>

                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, Converter={StaticResource ZeroToEmptyConverter}, StringFormat=N3}" Width="Auto"/>
                        <DataGridTextColumn x:Name="QuantityColumn" Header="الكمية" Binding="{Binding Quantity, Converter={StaticResource ZeroToEmptyConverter}}" Width="Auto"/>
                        <DataGridTextColumn x:Name="DonationTypeColumn" Header="النوع" Binding="{Binding DonationType}" Width="*"/>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="تعديل" Style="{StaticResource EditButton}" Click="EditAid_Click"/>
                                        <Button Content="حذف" Style="{StaticResource DeleteButton}" Click="DeleteAid_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
