<UserControl x:Class="AccountingApp.RevenuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AccountingApp"
             FlowDirection="RightToLeft"
             Background="#EDF2F7"
             Loaded="RevenuesView_Loaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3182CE"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E53E3E"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#DD6B20"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#A0AEC0"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2F855A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E0"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="#4A5568"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="EditButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">

            <TextBlock Text="الإيرادات" FontSize="24" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
            <TextBlock Text="السنة المالية:" Style="{StaticResource LabelStyle}" FontSize="16" Margin="50,0,10,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="YearComboBox" Width="100" Height="32" FontSize="16" VerticalAlignment="Center" SelectionChanged="YearComboBox_SelectionChanged"/>
            <TextBlock Text="رصيد الإيرادات:" Style="{StaticResource LabelStyle}" Margin="20,0,10,0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border CornerRadius="8" Background="{StaticResource SuccessBrush}" Padding="20,8" VerticalAlignment="Center">
                <TextBlock x:Name="RevenuesBalanceText" Text="0.000" FontSize="22" FontWeight="Bold" Foreground="White" />
            </Border>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="بحث وتصفية">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="رقم الدفتر:" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="SearchBookNoTextBox" Grid.Column="1" Margin="0,0,20,0" KeyDown="MoveFocusOnEnter"/>
                <TextBlock Grid.Column="2" Text="اسم المستلم:" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="SearchRecipientTextBox" Grid.Column="3" Margin="0,0,20,0" KeyDown="MoveFocusOnEnter"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="من تاريخ:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="SearchFromDateTextBox" Width="90" Margin="0,0,10,0" KeyDown="DateInput_KeyDown" TextAlignment="Center"/>
                    <TextBlock Text="إلى تاريخ:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="SearchToDateTextBox" Width="90" KeyDown="DateInput_KeyDown" TextAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,0">
                    <Button Content="بحث" Click="Search_Click"/>
                    <Button Content="عرض الكل" Click="ShowAll_Click"/>
                    <Button Content="طباعة" Margin="20,5,5,5" Background="{StaticResource SuccessBrush}" Click="Print_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <TabControl x:Name="InputTabControl" Grid.Row="2" Margin="0,0,0,15" FontSize="14" FontWeight="SemiBold" SelectionChanged="InputTabControl_SelectionChanged">

            <TabItem Header="إضافة / تعديل سند قبض">
                <Border Background="White" Padding="15" BorderThickness="1" BorderBrush="#CBD5E0" CornerRadius="0,0,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="تاريخ استلام السند:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="ReceiptDateTextBox" Width="110" KeyDown="DateInput_KeyDown" TextAlignment="Center"/>
                            <TextBlock Text="رقم الدفتر:" Style="{StaticResource LabelStyle}" Margin="20,0,10,0"/>
                            <TextBox x:Name="ReceiptBookNoTextBox" Width="110" KeyDown="MoveFocusOnEnter"/>
                            <TextBlock Text="من سند:" Style="{StaticResource LabelStyle}" Margin="20,0,10,0"/>
                            <TextBox x:Name="ReceiptFromVoucherNoTextBox" Width="110" KeyDown="MoveFocusOnEnter"/>
                            <TextBlock Text="إلى سند:" Style="{StaticResource LabelStyle}" Margin="20,0,10,0"/>
                            <TextBox x:Name="ReceiptToVoucherNoTextBox" Width="110" KeyDown="MoveFocusOnEnter"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="المبلغ:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="ReceiptAmountTextBox" Width="120" KeyDown="MoveFocusOnEnter"/>
                            <TextBlock Text="مستلم الدفتر:" Style="{StaticResource LabelStyle}" Margin="20,0,10,0"/>
                            <TextBox x:Name="ReceiptRecipientTextBox" Width="300" KeyDown="MoveFocusOnEnter"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="الملاحظات:" Style="{StaticResource LabelStyle}" VerticalAlignment="Top"/>
                            <TextBox x:Name="ReceiptNotesTextBox" Width="520" Height="40" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            <Button x:Name="AddUpdateButtonReceipt" Content="إضافة سند قبض" Click="AddUpdateReceiptVoucher_Click" Margin="20,0,0,0"/>
                            <Button x:Name="CancelReceiptEditButton" Content="إلغاء" Click="CancelEdit_Click" Visibility="Collapsed" Background="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="إضافة / تعديل إيداع">
                <Border Background="White" Padding="15" BorderThickness="1" BorderBrush="#CBD5E0" CornerRadius="0,0,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="تاريخ الإيداع:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="DepositDateTextBox" KeyDown="DateInput_KeyDown" TextAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="اسم المودع:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="0" Grid.Column="4" x:Name="DepositorNameTextBox" KeyDown="MoveFocusOnEnter"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="المبلغ:" Style="{StaticResource LabelStyle}" Margin="0,8,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DepositAmountTextBox" KeyDown="MoveFocusOnEnter" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="الملاحظات:" Style="{StaticResource LabelStyle}" VerticalAlignment="Top" Margin="0,8,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" x:Name="DepositNotesTextBox" Height="40" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Button x:Name="AddUpdateButtonDeposit" Content="إضافة إيداع" Click="AddUpdateDeposit_Click"/>
                            <Button x:Name="CancelDepositEditButton" Content="إلغاء" Click="CancelEdit_Click" Visibility="Collapsed" Background="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <TabControl x:Name="DataTabControl" Grid.Row="3" FontSize="14" FontWeight="SemiBold" SelectionChanged="DataTabControl_SelectionChanged">

            <TabItem Header="سندات القبض">
                <DataGrid x:Name="ReceiptsDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding ReceiptVouchers}" MinHeight="250">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاريخ" Binding="{Binding Date, StringFormat={x:Static local:AppSettings.DateFormat}}" Width="0.8*"/>
                        <DataGridTextColumn Header="رقم الدفتر" Binding="{Binding BookNo}" Width="0.8*"/>
                        <DataGridTextColumn Header="المستلم" Binding="{Binding Recipient}" Width="1.2*"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N3}" Width="0.9*"/>
                        <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="1.5*"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="تعديل" Style="{StaticResource EditButton}" Padding="10,4" Margin="2" MinWidth="60" Click="EditReceipt_Click"/>
                                        <Button Content="حذف" Style="{StaticResource DeleteButton}" Padding="10,4" Margin="2" MinWidth="60" Click="DeleteReceipt_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="الإيداعات">
                <DataGrid x:Name="DepositsDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Deposits}" MinHeight="250">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاريخ الإيداع" Binding="{Binding Date, StringFormat={x:Static local:AppSettings.DateFormat}}" Width="*"/>
                        <DataGridTextColumn Header="اسم المودع" Binding="{Binding DepositorName}" Width="1.3*"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N3}" Width="*"/>
                        <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="1.5*"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="تعديل" Style="{StaticResource EditButton}" Padding="10,4" Margin="2" MinWidth="60" Click="EditDeposit_Click"/>
                                        <Button Content="حذف" Style="{StaticResource DeleteButton}" Padding="10,4" Margin="2" MinWidth="60" Click="DeleteDeposit_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
