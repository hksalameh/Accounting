<UserControl x:Class="AccountingApp.FuelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AccountingApp"
             FlowDirection="RightToLeft"
             Background="#EDF2F7"
             Loaded="FuelView_Loaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3182CE"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E53E3E"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#DD6B20"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#A0AEC0"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2F855A"/>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="#4A5568"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="EditButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        </Style>
    </UserControl.Resources>

    <TabControl Margin="10" FontSize="14" FontWeight="SemiBold">
        <TabItem Header="فواتير الوقود">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="فواتير الوقود" FontSize="24" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                        <TextBlock Text="السنة المالية:" Style="{StaticResource LabelStyle}" FontSize="16" Margin="50,0,10,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="YearComboBox" Width="100" Height="32" FontSize="16" VerticalAlignment="Center" SelectionChanged="RefreshData_Event"/>
                    </StackPanel>

                    <Border Background="White" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="رقم السيارة:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="SearchCarComboBox" Grid.Column="1" Margin="0,0,20,0" Height="28"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="من تاريخ:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="SearchFromDateTextBox" Width="110" Margin="0,0,10,0" TextAlignment="Center" KeyDown="DateInput_KeyDown"/>
                                <TextBlock Text="إلى تاريخ:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="SearchToDateTextBox" Width="110" TextAlignment="Center" KeyDown="DateInput_KeyDown"/>
                            </StackPanel>
                            <CheckBox x:Name="ShowUnpaidOnlyCheckBox" Grid.Column="3" Content="عرض غير المدفوع فقط" VerticalAlignment="Center" Margin="20,0,0,0" Checked="RefreshData_Event" Unchecked="RefreshData_Event"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,0">
                                <Button Content="بحث" Click="RefreshData_Event"/>
                                <Button Content="عرض الكل" Click="ShowAll_Click"/>
                                <Button Content="طباعة" Margin="20,5,5,5" Background="{StaticResource SuccessBrush}" Click="Print_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="White" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="ملخص الاستهلاك حسب الفترة" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="السيارة:" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="SummaryCarComboBox" Width="150" Height="28"/>
                                <TextBlock Text="من تاريخ:" Style="{StaticResource LabelStyle}" Margin="20,0,10,0"/>
                                <TextBox x:Name="SummaryFromDateTextBox" Width="110" TextAlignment="Center" KeyDown="DateInput_KeyDown"/>
                                <TextBlock Text="إلى تاريخ:" Style="{StaticResource LabelStyle}" Margin="20,0,10,0"/>
                                <TextBox x:Name="SummaryToDateTextBox" Width="110" TextAlignment="Center" KeyDown="DateInput_KeyDown"/>
                                <Button Content="احسب الإجمالي" Margin="20,0,0,0" Click="CalculateTotal_Click"/>
                                <Border CornerRadius="5" Background="#EBF8FF" BorderBrush="#BEE3F8" BorderThickness="1" Padding="15,5" Margin="30,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="إجمالي الاستهلاك: " FontWeight="Bold" Foreground="#3182CE"/>
                                        <TextBlock x:Name="TotalAmountTextBlock" Text="0.000" FontWeight="Bold" Foreground="#3182CE"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="رقم السيارة:" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="InvoiceCarComboBox" Width="120" Height="28"/>

                                <TextBlock Text="تاريخ الفاتورة:" Style="{StaticResource LabelStyle}" Margin="15,0,10,0"/>
                                <TextBox x:Name="InvoiceDateTextBox" Width="120" TextAlignment="Center" KeyDown="InvoiceDate_KeyDown"/>

                                <TextBlock Text="رقم الفاتورة:" Style="{StaticResource LabelStyle}" Margin="15,0,10,0"/>
                                <TextBox x:Name="InvoiceNumberTextBox" Width="120" KeyDown="MoveFocusOnEnter"/>

                                <TextBlock Text="المبلغ:" Style="{StaticResource LabelStyle}" Margin="15,0,10,0"/>
                                <TextBox x:Name="AmountTextBox" Width="120" KeyDown="MoveFocusOnEnter"/>
                                <CheckBox x:Name="IsPaidCheckBox" Content="تم الدفع" VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                <Button x:Name="AddUpdateButton" Content="إضافة فاتورة" Click="AddUpdateInvoice_Click"/>
                                <Button x:Name="ClearButton" Content="مسح" Background="{StaticResource SecondaryBrush}" Click="ClearFields_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="White" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="8" Padding="5">
                        <DataGrid x:Name="FuelInvoicesDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ت. " Binding="{Binding Id}" Width="Auto"/>
                                <DataGridTextColumn Header="رقم السيارة" Binding="{Binding CarNumber}" Width="*"/>
                                <DataGridTextColumn Header="تاريخ الفاتورة" Binding="{Binding Date, StringFormat={x:Static local:AppSettings.DateFormat}}" Width="*"/>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="*"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N3}" Width="*"/>
                                <DataGridTemplateColumn Header="تم الدفع" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Text" Value="لا"/>
                                                        <Setter Property="Foreground" Value="Red"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                                <Setter Property="Text" Value="نعم"/>
                                                                <Setter Property="Foreground" Value="Green"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="الرصيد غير المدفوع المتراكم" Binding="{Binding AccumulatedBalance, StringFormat=N3}" Width="1.4*"/>
                                <DataGridTemplateColumn Header="الإجراءات" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="تعديل" Style="{StaticResource EditButton}" Padding="10,4" Margin="2" MinWidth="60" Click="EditInvoice_Click"/>
                                                <Button Content="حذف" Style="{StaticResource DeleteButton}" Padding="10,4" Margin="2" MinWidth="60" Click="DeleteInvoice_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="إدارة السيارات">
            <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="White" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="8" Padding="25" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="رقم السيارة:" Style="{StaticResource LabelStyle}" FontSize="16"/>
                        <TextBox x:Name="NewCarNumberTextBox" Width="200" FontSize="16" KeyDown="MoveFocusOnEnter"/>
                        <Button Content="إضافة سيارة" Margin="20,0,0,0" FontSize="14" Click="AddCar_Click"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="8" Padding="5">
                    <DataGrid x:Name="CarsDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="300" MaxWidth="500">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم السيارة" Binding="{Binding CarNumber}" Width="*"/>
                            <DataGridTemplateColumn Header="إجراء" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="حذف" Style="{StaticResource DeleteButton}" Padding="10,4" Margin="2" MinWidth="60" Click="DeleteCar_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </TabItem>
    </TabControl>
</UserControl>
